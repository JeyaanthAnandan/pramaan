# Copy to .env.local for local development. Never commit .env.local.
# Production (Cloud Run) uses the service account; no API keys.
GOOGLE_CLOUD_PROJECT=copilot-manufacturing
PRAMAAN_REGION=asia-southeast1
GEMINI_LOCATION=global
# vertex = Gemini Enterprise Agent Platform via ADC; api_key = Gemini Developer API
GEMINI_MODE=vertex
# GEMINI_API_KEY=your-local-key   # only with GEMINI_MODE=api_key (also needed for File Search stores)
MODEL_FLASH=gemini-3.8-flash
MODEL_LITE=gemini-3.5-flash-lite
STORE_BACKEND=memory              # memory | firestore
PRAMAAN_BUCKET=                   # e.g. copilot-manufacturing-pramaan (GCS) - empty = local disk
